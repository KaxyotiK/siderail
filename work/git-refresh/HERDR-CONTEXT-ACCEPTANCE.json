    "platform": "darwin",
    "arch": "arm64",
    "node": "v24.19.0",
    "herdr": {
      "version": "0.8.2",
      "protocol": 20
    },
    "nodeAvailability": {
      "22": {
        "executable": "/opt/homebrew/opt/node@22/bin/node",
        "available": true,
        "version": "v22.23.2"
      },
      "24": {
        "executable": "/opt/homebrew/opt/node@24/bin/node",
        "available": true,
        "version": "v24.19.0"
      }
    },
    "linuxRuntimeAvailable": false
