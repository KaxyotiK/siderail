{
  "name": "siderail",
  "version": "0.1.1",
  "description": "A compact, read-only Files and Git sidebar for Herdr and cmux",
  "keywords": [
    "herdr",
    "herdr-plugin",
    "cmux",
    "git",
    "sidebar",
    "tui",
    "terminal"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaxyotiK/siderail.git"
  },
  "bugs": {
    "url": "https://github.com/KaxyotiK/siderail/issues"
  },
  "homepage": "https://github.com/KaxyotiK/siderail#readme",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "siderail": "scripts/cli.mjs"
  },
  "files": [
    "src/",
    "scripts/auto-open-herdr-tabs.mjs",
    "scripts/cli.mjs",
    "scripts/cmux-node-launcher.sh",
    "scripts/cmux-siderail.mjs",
    "scripts/file-preview.mjs",
    "scripts/git-state-coordinator.mjs",
    "scripts/node-launcher.sh",
    "scripts/open-herdr-panel.mjs",
    "scripts/open-herdr-panel.sh",
    "scripts/resize-herdr-sidebar.mjs",
    "scripts/siderail.mjs",
    "scripts/temporary-copy-cleaner.mjs",
    "scripts/uninstall-herdr-plugin.mjs",
    "herdr-plugin.toml",
    "siderail.config.example.json",
    "CHANGELOG.md",
    "docs/CMUX.md",
    "docs/INSTALLATION.md",
    "docs/THEMING.md",
    "docs/TROUBLESHOOTING.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "lint": "node scripts/lint.mjs && eslint . && knip --include exports",
    "format:check": "node scripts/lint.mjs",
    "snapshot": "node scripts/siderail.mjs --demo --snapshot --width 52 --height 46",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**/*.mjs' --test-coverage-lines=95 --test-coverage-branches=86 --test-coverage-functions=95 test/*.test.mjs",
    "artifact:verify": "node scripts/verify-artifact.mjs",
    "screenshots:verify": "node scripts/verify-screenshots.mjs",
    "release:evidence": "node scripts/release-evidence.mjs",
    "fixture:verify": "node --test test/integration.test.mjs",
    "live:herdr:smoke": "node scripts/live-herdr-smoke.mjs",
    "live:release:smoke": "/bin/bash scripts/run-isolated-live-smoke.sh",
    "install:verify": "/bin/bash scripts/verify-npm-install.sh",
    "cmux:launch": "/bin/bash scripts/node-launcher.sh scripts/open-cmux-dock.mjs",
    "uninstall:herdr": "/bin/bash scripts/node-launcher.sh scripts/uninstall-herdr-plugin.mjs",
    "check": "npm run lint && npm run test:coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "knip": "6.34.0"
  },
  "knip": {
    "entry": [
      "scripts/*.mjs",
      "test/*.test.mjs"
    ],
    "project": [
      "src/**/*.mjs",
      "scripts/**/*.mjs",
      "test/**/*.mjs"
    ]
  }
}
