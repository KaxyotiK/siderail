{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KaxyotiK/git-rail/main/schema/v1/git-rail.schema.json",
  "title": "Herdr GitRail configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "baseRef": { "type": "string", "pattern": "\\S" },
    "herdr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoOpen": { "type": "boolean", "default": true }
      }
    },
    "editor": { "$ref": "#/$defs/launch" },
    "viewers": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/viewer" },
          {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/viewer" }
          }
        ]
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pollIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxFileBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 },
        "maxDiffBytes": { "type": "integer", "minimum": 1024, "maximum": 67108864 }
      }
    }
  },
  "required": ["version"],
  "$defs": {
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": { "type": "string", "pattern": "\\S" },
        "args": { "type": "array", "items": { "type": "string" } },
        "mode": { "enum": ["auto", "terminal", "external"] }
      },
      "required": ["client"]
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "pattern": "\\S" },
        "client": { "type": "string", "pattern": "\\S" },
        "args": { "type": "array", "items": { "type": "string" } },
        "mode": { "enum": ["auto", "terminal", "external"] },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]$",
          "not": { "enum": ["1", "2", "e", "q", "j", "k", "g", "G", "n", "N"] }
        },
        "order": { "type": "integer", "minimum": -10000, "maximum": 10000, "deprecated": true },
        "autoOpen": { "type": "boolean" }
      },
      "required": ["client"]
    }
  }
}
