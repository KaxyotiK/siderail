{
  "$schema": "https://raw.githubusercontent.com/KaxyotiK/git-rail/main/schema/v1/git-rail.schema.json",
  "version": 1,
  "baseRef": "origin/main",
  "viewers": {
    ".md": {
      "label": "View Markdown",
      "client": "glow",
      "args": ["--tui", "--style", "dark"],
      "mode": "terminal",
      "key": "3",
      "autoOpen": true
    },
    ".pdf": {
      "label": "Open PDF",
      "client": "system",
      "args": [],
      "mode": "external",
      "key": "p",
      "autoOpen": false
    },
    "*": [
      {
        "label": "Open",
        "client": "system",
        "args": [],
        "mode": "external",
        "key": "o",
        "autoOpen": false
      },
      {
        "label": "Open in Code",
        "client": "code",
        "args": ["--reuse-window"],
        "mode": "external",
        "key": "9",
        "autoOpen": false
      }
    ]
  },
  "refresh": {
    "pollIntervalMs": 10000
  },
  "limits": {
    "maxFileBytes": 4194304,
    "maxDiffBytes": 8388608
  }
}
